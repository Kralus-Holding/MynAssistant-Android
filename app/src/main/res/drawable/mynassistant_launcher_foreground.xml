<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A slight zoom makes the existing MynAssistant mark fill the rounded app tile more like the reference icon. -->
    <item
        android:left="-8dp"
        android:top="-8dp"
        android:right="-8dp"
        android:bottom="-8dp">
        <bitmap
            android:src="@drawable/mynassistant_launcher"
            android:gravity="fill" />
    </item>
</layer-list>
