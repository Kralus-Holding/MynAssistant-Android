rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // USERS
    // =========================
    match /users/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // =========================
    // DEVICES
    // =========================
    match /devices/{deviceId} {
      allow read: if isSignedIn()
                  && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid;

      allow delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;
    }

    // =========================
    // COMMANDS
    // =========================
    match /commands/{commandId} {
      allow read: if isSignedIn()
                  && resource.data.ownerId == request.auth.uid;

      // A phone may enqueue work only for a server-connected Windows device owned by the same user.
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.deviceId is string
                    && request.resource.data.command is string
                    && request.resource.data.status == 'pending'
                    && exists(/databases/$(database)/documents/devices/$(request.resource.data.deviceId))
                    && get(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)).data.ownerId == request.auth.uid
                    && get(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)).data.connectionMode == 'firebase-agent'
                    && get(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)).data.platform == 'Windows';

      // Clients cannot retarget or rewrite a command after it has entered the server queue.
      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid
                    && resource.data.deviceId == request.resource.data.deviceId
                    && resource.data.command == request.resource.data.command;

      allow delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;
    }

    // =========================
    // CONTACTS
    // =========================
    match /contacts/{contactId} {
      allow read: if isSignedIn()
                  && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid;

      allow delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;
    }

    // =========================
    // HELPERS
    // =========================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
  }
}
